{
    "name": "anklimsk/wpkg-express-2",
    "description": "A web-based frontend to WPKG",
    "type": "project",
    "keywords": [
        "wpkg",
        "wpkg-express-2"
    ],
    "homepage": "https://github.com/itkoncept/wpkg-express-2",
    "version": "2.0.0",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Brian White",
            "role": "Original author",
            "homepage": "https://code.google.com/archive/p/wpkgexpress"
        },
        {
            "name": "Andrey Klimov",
            "role": "Author",
            "homepage": "https://anklimsk.github.io/wpkg-express-2"
        },
        {
            "name": "Mark Mortensen",
            "role": "Maintainer",
            "homepage": "https://github.com/itkoncept/wpkg-express-2"
        }
    ],
    "require": {
        "php": ">=5.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^3.7",
        "cakephp/cakephp-codesniffer": "^1.0.0"
    },
    "config": {
        "vendor-dir": "vendors/",
        "process-timeout": 0
    },
    "bin": [
        "app/Cake/Console/cake"
    ],
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "./vendors/bin/phpcs -p --extensions=php --standard=CakePHP ./app",
        "test": "./app/Console/cake test app AllApp --stderr"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
